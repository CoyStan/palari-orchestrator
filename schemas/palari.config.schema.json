{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoyStan/palari-orchestrator/schemas/palari.config.schema.json",
  "title": "Palari Orchestration Config",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "project_name",
    "default_branch",
    "tickets_open_dir",
    "tickets_closed_dir",
    "reports_dir",
    "human_reports_dir",
    "evidence_dir",
    "handoffs_dir",
    "roles_active_dir",
    "roles_proposed_dir",
    "roles_revoked_dir",
    "worktree_base",
    "default_forbidden_paths"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "tickets_open_dir": {
      "type": "string",
      "minLength": 1
    },
    "tickets_proposed_dir": {
      "type": "string",
      "minLength": 1
    },
    "tickets_closed_dir": {
      "type": "string",
      "minLength": 1
    },
    "reports_dir": {
      "type": "string",
      "minLength": 1
    },
    "human_reports_dir": {
      "type": "string",
      "minLength": 1
    },
    "planning_reports_dir": {
      "type": "string",
      "minLength": 1
    },
    "evidence_dir": {
      "type": "string",
      "minLength": 1
    },
    "handoffs_dir": {
      "type": "string",
      "minLength": 1
    },
    "roles_active_dir": {
      "type": "string",
      "minLength": 1
    },
    "roles_proposed_dir": {
      "type": "string",
      "minLength": 1
    },
    "roles_revoked_dir": {
      "type": "string",
      "minLength": 1
    },
    "agent_skills_dir": {
      "type": "string",
      "minLength": 1
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "memory_dir": {
      "type": "string",
      "minLength": 1
    },
    "memory_index_backend": {
      "type": "string",
      "enum": [
        "sqlite",
        "json",
        "none"
      ]
    },
    "memory_cache_dir": {
      "type": "string",
      "minLength": 1
    },
    "memory_packet_limit": {
      "type": "integer",
      "minimum": 0
    },
    "memory_related_limit": {
      "type": "integer",
      "minimum": 0
    },
    "memory_active_only_default": {
      "type": "boolean"
    },
    "worktree_base": {
      "type": "string",
      "minLength": 1
    },
    "claim_lease_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "scope_overlap_policy": {
      "type": "string",
      "enum": [
        "warn",
        "block"
      ]
    },
    "authority_profile": {
      "type": "string",
      "enum": [
        "solo-founder",
        "team-safe",
        "strict"
      ]
    },
    "authority_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "agent_can_commit": {
            "type": "boolean"
          },
          "agent_can_push_branch": {
            "type": "boolean"
          },
          "agent_can_open_pr": {
            "type": "boolean"
          },
          "agent_can_merge_main": {
            "type": "boolean"
          },
          "agent_can_accept": {
            "type": [
              "boolean",
              "string"
            ],
            "enum": [
              true,
              false,
              "user-explicit"
            ]
          }
        }
      }
    },
    "concurrency_ignored_overlap_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hygiene_generated_paths": {
      "type": "array",
      "description": "Generated/local artifact globs that palari hygiene classifies separately from source changes.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "default_forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_reports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "implementation_self_acceptance": {
          "type": "string",
          "enum": [
            "forbidden",
            "allowed-by-config"
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "description": "Forge-proof accept gate settings. When enabled, palari accept requires a cryptographic verdict from the vendored forgegate kernel and fails closed if the kernel is unavailable.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "layout": {
          "type": "string",
          "default": "layouts/palari-change.yml",
          "description": "Layout file declaring required steps, hash flow, and dual control."
        },
        "keys_dir": {
          "type": "string",
          "default": ".palari/gate/keys",
          "description": "Directory for private keys and tokens. Must stay gitignored."
        },
        "root_pub_file": {
          "type": "string",
          "default": ".palari/gate/root.pub"
        },
        "token_validity_days": {
          "type": "integer",
          "minimum": 1,
          "default": 365
        },
        "ticket_token_days": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 86400,
          "description": "Verification refuses evidence older than this window; always paired with verify_time so backdated evidence is refused."
        },
        "ci_key": {
          "type": "string",
          "default": "ci",
          "description": "Key identity that signs the test step."
        }
      }
    },
    "goals_active_dir": {
      "type": "string",
      "description": "Directory for active goal artifacts."
    },
    "goals_proposed_dir": {
      "type": "string",
      "description": "Directory for proposed goal artifacts."
    },
    "goals_closed_dir": {
      "type": "string",
      "description": "Directory for closed (achieved or dropped) goals."
    },
    "require_serves_goal": {
      "type": "string",
      "description": "off | warn | strict. Whether tickets must link an active goal via serves_goal.",
      "enum": [
        "off",
        "warn",
        "strict"
      ]
    },
    "decisions_open_dir": {
      "type": "string",
      "description": "Directory for open decision artifacts awaiting a human."
    },
    "workflows_proposed_dir": {
      "type": "string",
      "description": "Directory for proposed workflow artifacts."
    },
    "workflows_active_dir": {
      "type": "string",
      "description": "Directory for active workflow artifacts."
    },
    "workflows_closed_dir": {
      "type": "string",
      "description": "Directory for closed workflow artifacts."
    },
    "humans_proposed_dir": {
      "type": "string",
      "description": "Directory for proposed human governance profiles."
    },
    "humans_active_dir": {
      "type": "string",
      "description": "Directory for active human governance profiles."
    },
    "humans_revoked_dir": {
      "type": "string",
      "description": "Directory for revoked human governance profiles."
    },
    "decisions_decided_dir": {
      "type": "string",
      "description": "Directory for recorded decisions."
    },
    "model_routing_enabled": {
      "type": "string",
      "description": "true|false. Route agent runs by risk tier when no explicit model is given."
    },
    "model_class_r1": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "frontier"
      ],
      "description": "Model class for R1 work."
    },
    "model_class_r2": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "frontier"
      ],
      "description": "Model class for R2 work."
    },
    "model_class_r3": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "frontier"
      ],
      "description": "Model class for R3 work."
    },
    "model_class_r4": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "frontier"
      ],
      "description": "Model class for R4 work."
    },
    "model_class_r5": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "frontier"
      ],
      "description": "Model class for R5 governance/kernel work."
    },
    "model_class_default": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "frontier"
      ],
      "description": "Model class for DEFAULT work."
    },
    "openrouter_enabled": {
      "type": "string",
      "description": "true|false. Enable the OpenRouter text-artifact executor."
    },
    "openrouter_api_key_env": {
      "type": "string",
      "description": "Environment variable holding the OpenRouter API key; never stored in the repo."
    },
    "openrouter_base_url": {
      "type": "string",
      "description": "OpenRouter API base URL."
    },
    "openrouter_allowed_models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Allowlist of OpenRouter model ids the adapter may use; fail-closed."
    },
    "openrouter_advisor_model": {
      "type": "string",
      "description": "Optional advisor model for the openrouter:advisor server tool."
    },
    "openrouter_advisor_name": {
      "type": "string",
      "description": "Optional advisor name."
    },
    "openrouter_advisor_instructions": {
      "type": "string",
      "description": "Optional advisor persona instructions."
    },
    "openrouter_temperature": {
      "type": "string",
      "description": "Sampling temperature for deterministic-ish runs (default 0)."
    },
    "openrouter_seed": {
      "type": "string",
      "description": "Fixed seed for reproducibility where supported."
    },
    "openrouter_timeout_seconds": {
      "type": "string",
      "description": "HTTP timeout for OpenRouter requests."
    }
  }
}
