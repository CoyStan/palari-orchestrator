{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CoyStan/palari-orchestrator/schemas/palari.config.schema.json",
  "title": "Palari Orchestration Config",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "project_name",
    "default_branch",
    "tickets_open_dir",
    "tickets_closed_dir",
    "reports_dir",
    "human_reports_dir",
    "evidence_dir",
    "handoffs_dir",
    "worktree_base",
    "default_forbidden_paths"
  ],
  "properties": {
    "project_name": { "type": "string", "minLength": 1 },
    "default_branch": { "type": "string", "minLength": 1 },
    "tickets_open_dir": { "type": "string", "minLength": 1 },
    "tickets_proposed_dir": { "type": "string", "minLength": 1 },
    "tickets_closed_dir": { "type": "string", "minLength": 1 },
    "reports_dir": { "type": "string", "minLength": 1 },
    "human_reports_dir": { "type": "string", "minLength": 1 },
    "planning_reports_dir": { "type": "string", "minLength": 1 },
    "evidence_dir": { "type": "string", "minLength": 1 },
    "handoffs_dir": { "type": "string", "minLength": 1 },
    "agent_skills_dir": { "type": "string", "minLength": 1 },
    "state_dir": { "type": "string", "minLength": 1 },
    "memory_dir": { "type": "string", "minLength": 1 },
    "memory_index_backend": {
      "type": "string",
      "enum": ["sqlite", "json", "none"]
    },
    "memory_cache_dir": { "type": "string", "minLength": 1 },
    "memory_packet_limit": { "type": "integer", "minimum": 0 },
    "memory_related_limit": { "type": "integer", "minimum": 0 },
    "memory_active_only_default": { "type": "boolean" },
    "worktree_base": { "type": "string", "minLength": 1 },
    "claim_lease_seconds": { "type": "integer", "minimum": 1 },
    "scope_overlap_policy": {
      "type": "string",
      "enum": ["warn", "block"]
    },
    "concurrency_ignored_overlap_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "default_forbidden_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_reports": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "implementation_self_acceptance": {
          "type": "string",
          "enum": ["forbidden", "allowed-by-config"]
        }
      }
    }
  }
}
